# --- archival / unrelated trees (kept on disk, not versioned here) ---
history_version/

# --- runtime state (regenerated by the agent; never committed) ---
runtime/
reviews/
*.pid

# --- secrets ---
.env
.env.*
!.env.example

# --- logs & terminal captures ---
*.log
!docs/evidence/fresh-clone.log
*.log.*
screenlog.*
ollama.log
engine.log
daemon.out*

# --- python ---
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/

# --- stale lock file from a dead Claude session ---
.claude/scheduled_tasks.lock

# --- editors / OS ---
.DS_Store
*.swp
.idea/
.vscode/
