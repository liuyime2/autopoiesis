# --- archival / unrelated trees (kept on disk, not versioned here) ---
history_version/

# --- runtime state (regenerated by the agent; never committed) ---
runtime/
reviews/
*.pid

# --- secrets ---
.env
.env.*
!.env.example

# --- logs & terminal captures ---
*.log
!docs/evidence/fresh-clone.log
*.log.*
screenlog.*
ollama.log
engine.log
daemon.out*

# --- python ---
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/

# --- agent session state (regenerated per session; not project content) ---
# Goal JSONs carry session ids, worktree fingerprints and the runtime's own
# progress notes. Three of them were tracked, which put a `M` in `git status` on
# every single turn and would have published internal session state to a public
# repository. Nothing reads them: all three verify gates that walk the tree
# already skip `.opencode`.
.opencode/goals/

# --- stale lock file from a dead Claude session ---
.claude/scheduled_tasks.lock

# --- editors / OS ---
.DS_Store
*.swp
.idea/
.vscode/

# --- loop and harness state (regenerated per session; not project content) ---
# The loop's goal, its attempts log and its criterion checks are process records about *how* a
# change was made. They are the working notes that produced the change, not the change, and a
# reader of the repository wants the commit and its message - not the twenty attempts that got
# there. `.opencode/goals/` above was already excluded for the same reason; this is the same
# rule applied to the rest of it.
.opencode/loop-history/
