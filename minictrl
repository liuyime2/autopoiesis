#!/usr/bin/env bash
# minictrl - the single command for operating the paper-trading agent.
#
#   minictrl doctor              check everything, non-zero on any fault
#   minictrl once                run one cycle
#   minictrl loop [n]            run n cycles (default 5) and stop
#   minictrl daemon               run the daemon in the foreground
#   minictrl install-service     install the systemd --user unit (reboot-persistent)
#   minictrl service             status|start|stop|restart|logs for the unit
#   minictrl status              account, position and clock
#   minictrl stop                stop the daemon
#   minictrl reconcile           match pending orders against the broker
#   minictrl evidence ingest|report   refresh or show broker evidence
#   minictrl owner-history       journal the account owner's fills (read-only), to price the 29 shares
#   minictrl profit              verify the paper-profit target from broker evidence
#   minictrl check-env           report configuration and connectivity only
#   minictrl test|audit          unit tests; the recorded-defect audit
#
set -uo pipefail

ROOT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
cd "$ROOT_DIR" || exit 2
# ---------------------------------------------------------------------------
# Notes on why this script looks the way it does. Kept below the command list so
# `minictrl help` prints commands and not an essay; a reader who wants the reasoning
# opens the file.
# `loop` took `--cycles 5`, a flag that has never existed: cli.py defines `--max-cycles`, and
# minictrl forwarded the extra words, so the documented command failed with "unrecognized
# arguments". The count is now a positional argument. It was also printed in minictrl's own
# header and in the runbook, so three places advertised a command that could not run.
#
# Every subcommand propagates its real exit code. The previous scripts did not:
# `set -e` without `pipefail` meant a `| tee` pipeline reported tee's status, so
# a missing interpreter or an unreachable broker printed a green banner and
# exited 0. That is how auto-fix.log and market-check.log came to contain a
# header and a footer with nothing in between, stamped "success".
# `loop` accepts a positional count as well as `--cycles N`, because three documents
# wrote the flag form and it never worked. Translating it is cheaper than editing
# every caller.

# The operator's configuration is loaded once, here, before anything is looked up - and it is
# exported so subprocesses see the same values. It used to be read ~60 lines later, purely to
# fill @ENVFILE@ into the unit templates, which meant every discovery below ran against a
# process that had not yet seen the file: `MIN_AGENT_ENVBIN` named in the file was ignored, so a
# host whose environment lives outside conda's default envs root could not be installed at all.
# Values already present in the real environment win, because `set -a` re-exports an assignment
# rather than replacing an inherited one.
# The credential file moved with the project. Both names are honoured, the new one first, so
# an operator who has not moved their file gets a working daemon rather than an auth error
# with nothing pointing at the rename.
ENV_FILE="${MIN_AGENT_ENV_FILE:-${AUTOPOIESIS_ENV_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/autopoiesis/env}}"
# The legacy name is still honoured when the operator has not moved their file. Tested rather than
# assumed, because the default above points at the new path whether or not it exists.
if [ ! -f "$ENV_FILE" ] && [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/min-agent/env" ]; then
  ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/min-agent/env"
fi
if [ -f "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
elif [ -z "${ALPACA_API_KEY:-}" ] && [ "${MIN_AGENT_REQUIRE_CREDENTIALS:-0}" = "1" ]; then
  echo "FATAL: no credentials at $ENV_FILE" >&2
  exit 2
fi

export PYTHONPATH="$ROOT_DIR/src:${PYTHONPATH:-}"
export MIN_AGENT_MODE="${MIN_AGENT_MODE:-paper}"
export OLLAMA_BASE_URL="${OLLAMA_BASE_URL:-http://127.0.0.1:11434}"
export MIN_AGENT_MODEL="${MIN_AGENT_MODEL:-qwen3.8:27b}"
export MIN_AGENT_CURRICULUM_ENABLED="${MIN_AGENT_CURRICULUM_ENABLED:-true}"
# The paper URL is set by default, never forced. It used to be assigned unconditionally,
# which silently overrode an operator's own ALPACA_BASE_URL for every minictrl subcommand
# including the ones the gate runs. cli.py already refuses to build a client against a
# non-paper URL, so forcing it here bought no safety and cost the ability to configure it.
export ALPACA_BASE_URL="${ALPACA_BASE_URL:-https://paper-api.alpaca.markets}"
export APCA_API_BASE_URL="${APCA_API_BASE_URL:-$ALPACA_BASE_URL}"

SERVICE_NAME="autopoiesis.service"
# The interpreter is found, never assumed: an explicit override, then the active environment
# (a venv or a conda env), then conda's configured env roots. Every subcommand runs that one
# python directly. conda is not required: it used to be, through conda's runner with a
# hardcoded env name, which made a plain venv - the simplest install there is - unable to run
# any subcommand.
# `make install` puts the package in whatever environment is active, so an operator who
# followed the README has one and does not need to name it.

ENVBIN="${MIN_AGENT_ENVBIN:-}"
if [ -z "$ENVBIN" ] && [ -n "${VIRTUAL_ENV:-}" ] && [ -x "$VIRTUAL_ENV/bin/python" ]; then
  ENVBIN="$VIRTUAL_ENV/bin"
fi
if [ -z "$ENVBIN" ] && [ -n "${CONDA_PREFIX:-}" ] && [ -x "$CONDA_PREFIX/bin/python" ]; then
  ENVBIN="$CONDA_PREFIX/bin"
fi
if [ -z "$ENVBIN" ]; then
  # Env roots conda itself is configured to use, before the well-known install prefixes. A
  # non-default envs directory is a normal configuration, not this account's peculiarity, and
  # naming one account's layout here is what made a fresh clone un-runnable on any other host.
  for root in "${CONDA_ENVS_PATH:-}" /opt/conda/envs; do
    [ -n "$root" ] || continue
    for name in llm base; do
      if [ -x "$root/$name/bin/python" ]; then ENVBIN="$root/$name/bin"; break 2; fi
    done
  done
fi
if [ -z "$ENVBIN" ]; then
  for candidate in "$HOME/miniconda3/envs/llm/bin" "$HOME/miniforge3/envs/llm/bin"; do
    if [ -x "$candidate/python" ]; then ENVBIN="$candidate"; break; fi
  done
fi
if [ -z "$ENVBIN" ] || [ ! -x "$ENVBIN/python" ]; then
  echo "FATAL: no python environment found. Any of:" >&2
  echo "  * activate the venv or conda env you ran 'make install' in" >&2
  echo "  * set MIN_AGENT_ENVBIN to its bin directory" >&2
  echo "  * set CONDA_ENVS_PATH if conda keeps its envs outside the default root" >&2
  exit 2
fi
PYTHON_BIN="$ENVBIN/python"
# Credentials live outside the working tree so git can never see them.
agent() {
  timeout "${MIN_AGENT_TIMEOUT:-180}" "$PYTHON_BIN" -m autopoiesis.cli "$@"
}

# The comment block ends at the first non-comment line. `sed -n '2,20p'` ran past it, so
# `./minictrl help` - which the runbook tells the reader to run for the command list - printed
# six lines of shell source ending in `set -uo pipefail`. Derived from the file rather than
# hardcoded, so adding a line to the header cannot put the range out of date again.
# Only the command list, then. The header also carries the reasoning behind `set -uo
# pipefail` and behind accepting `--cycles`, which is worth having in the source and not in
# the output of a command a reader runs to find out what commands exist. Stops at the first
# blank comment line, which is where the prose begins.
usage() {
  awk 'NR > 1 {
          if ($0 !~ /^#/) exit
          sub(/^# ?/, ""); print
        }' "$0"
}

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
  doctor)          agent --doctor "$@" ;;
  once)            agent --once "$@" ;;
  # A positional count, and "--cycles N" accepted too, because three documents - minictrl's
  # own header, the runbook, and muscle memory - all wrote `--cycles 5` and it has never
  # worked. Translating it here is cheaper than editing every caller and breaking the habit.
  loop)
    _cycles="${MIN_AGENT_CYCLES:-5}"
    case "${1:-}" in
      --cycles) _cycles="${2:-5}"; shift 2 ;;
      --cycles=*) _cycles="${1#*=}"; shift ;;
      [0-9]*) _cycles="$1"; shift ;;
    esac
    agent --daemon --max-cycles "$_cycles" "$@" ;;
  daemon)          exec "$PYTHON_BIN" -m autopoiesis.cli --daemon ;;
  status)          agent --status ;;
  stop)            agent --stop ;;
  reconcile)       agent --reconcile ;;
  evidence)        agent --ingest-evidence ;;
  owner-history)   agent --ingest-owner-history ;;
  report)          agent --evidence-report ;;
  profit)          agent --verify-profit-target ;;
  check-env)       agent --check-env ;;
  test)            "$PYTHON_BIN" -m pytest tests/autopoiesis -q "$@" ;;
  audit)           "$PYTHON_BIN" tools/audit_defects.py ;;

  install-service)
    # The systemd user manager resolves unit paths from ITS OWN start-time
    # environment, not this shell's. On this host it has no XDG_CONFIG_HOME, so
    # Detect that instead of silently
    # writing somewhere the manager will never read.
    unit_dir="$("$ROOT_DIR/tools/systemd_unit_dir.sh")" || exit 2
    mkdir -p "$unit_dir" || { echo "FATAL: cannot create $unit_dir" >&2; exit 2; }
# The ollama binary and its model directory have to be *found*, not assumed.
      # The old fallback was the literal `/usr/local/bin/ollama`, and `command -v`
      # finds nothing here, so the rendered unit was given a path that does not
      # exist on this host. Nothing failed at install time - `systemd-analyze verify`
      # does not stat ExecStart - and the unit only failed when it was next started,
      # 40 minutes after a single binary path went missing on a service that had
      # otherwise been up for a day and a half. Ollama is what decides trades, so
      # for that window every decision silently came from the policy engine instead
      # of the model, and only `doctor` noticed.
      #
      # So it reads the project's own configuration first, then PATH, and then
      # refuses. A candidate list of plausible directories was tried and dropped:
      # the real install here is under neither `$HOME` nor `/usr/local`, so any
      # list that happened to include it would be a list written for one machine,
      # which is the implicit state this project is supposed to stop depending on.
      # A declared setting is portable; a guessed path is not.
      env_setting() {
        [ -r "$ENV_FILE" ] || return 1
        sed -n "s/^[[:space:]]*$1=//p" "$ENV_FILE" | tail -n1 | sed 's/^["'\'']//; s/["'\'']$//'
      }
      OLLAMA_BIN_RESOLVED="${OLLAMA_BIN:-$(env_setting OLLAMA_BIN)}"
      if [ -z "$OLLAMA_BIN_RESOLVED" ]; then
        OLLAMA_BIN_RESOLVED="$(command -v ollama 2>/dev/null || true)"
      fi
      if [ -z "$OLLAMA_BIN_RESOLVED" ] || [ ! -x "$OLLAMA_BIN_RESOLVED" ]; then
        echo "FATAL: cannot find an executable ollama, so ollama.service cannot be" >&2
        echo "       written - a unit pointing at a missing binary does not fail" >&2
        echo "       here, it fails whenever the service is next started." >&2
        echo "       Add OLLAMA_BIN=/path/to/ollama to $ENV_FILE and re-run" >&2
        echo "       'minictrl install-service', or export it for this run." >&2
        exit 2
      fi
      OLLAMA_MODELS_RESOLVED="${OLLAMA_MODELS:-$(env_setting OLLAMA_MODELS)}"
      if [ -z "$OLLAMA_MODELS_RESOLVED" ] || [ ! -d "$OLLAMA_MODELS_RESOLVED" ]; then
        echo "FATAL: cannot find an ollama model directory." >&2
        echo "       Add OLLAMA_MODELS=/path/to/models to $ENV_FILE and re-run" >&2
        echo "       'minictrl install-service', or export it for this run." >&2
        exit 2
      fi
      render() {
        sed -e "s|@ROOT@|$ROOT_DIR|g" \
            -e "s|@PYTHON@|$PYTHON_BIN|g" \
            -e "s|@ENVBIN@|$ENVBIN|g" \
            -e "s|@ENVFILE@|$ENV_FILE|g" \
            -e "s|@OLLAMA_BIN@|$OLLAMA_BIN_RESOLVED|g" \
            -e "s|@OLLAMA_MODELS@|$OLLAMA_MODELS_RESOLVED|g" \
            "$1" > "$unit_dir/$2"
      }
    render "$ROOT_DIR/tools/autopoiesis.service.in"  "$SERVICE_NAME"
    render "$ROOT_DIR/tools/ollama.service.in"     "ollama.service"
    render "$ROOT_DIR/tools/watchdog.service.in"  "quant-watchdog.service"
    cp "$ROOT_DIR/tools/watchdog.timer" "$unit_dir/quant-watchdog.timer"
    # The research search is a fourth unit rather than something the daemon invokes, because the
    # separation in src/autopoiesis/research/__init__.py is enforced by a gate that fails when any
    # production module imports the research package. Letting the daemon run it would break that
    # gate for the sake of one scheduler, and a component that both searches and trades can grade
    # itself on its own output.
    render "$ROOT_DIR/tools/research.service.in"   "quant-research.service"
    cp "$ROOT_DIR/tools/research.timer" "$unit_dir/quant-research.timer"
    render "$ROOT_DIR/tools/report.service.in"     "quant-report.service"
    cp "$ROOT_DIR/tools/report.timer" "$unit_dir/quant-report.timer"
    systemd-analyze verify "$unit_dir/$SERVICE_NAME" "$unit_dir/ollama.service" \
        "$unit_dir/quant-watchdog.service" "$unit_dir/quant-research.service" \
        "$unit_dir/quant-report.service" 2>&1 \
        | grep -viE "not found|canonical" | head -5
    systemctl --user daemon-reload
    echo "wrote 8 unit files to $unit_dir"

    # Verify the manager can actually SEE them before claiming success. The
    # manager resolves unit paths from its own start-time environment, so a
    # directory that is merely writable is not enough. Claiming "enabled" after
    # a failed enable is the same false-success bug that let auto-fix.sh report a
    # dead strategy as healthy.
    failed=0
    for u in "$SERVICE_NAME" ollama.service; do
      if systemctl --user enable "$u" 2>/dev/null; then
        echo "  enabled $u"
      else
        echo "  NOT enabled $u - the manager did not pick it up" >&2
        failed=$((failed + 1))
      fi
    done

    # Timers are enabled *and started*, and the started state is checked rather than assumed.
    # `enable` alone only arranges for the timer to run at next boot, so a fresh install reported
    # "enabled quant-watchdog.timer" and "enabled quant-research.timer" while `list-timers` showed
    # the research one with no next-run at all and `minictrl service start` - which starts only the
    # daemon - could not start it. A timer that is enabled but not running is the same
    # false-success as a unit in a directory the manager never opens: it looks configured and does
    # nothing. This is why quant-research.timer sat `inactive (dead)` with `Trigger: n/a` while
    # the watchdog next to it was `active (waiting)`.
    for t in quant-watchdog.timer quant-research.timer quant-report.timer; do
      if systemctl --user enable --now "$t" 2>/dev/null; then
        if systemctl --user is-active --quiet "$t"; then
          echo "  enabled and running $t"
        else
          echo "  $t enabled but NOT running - it will not fire until started" >&2
          failed=$((failed + 1))
        fi
      else
        echo "  NOT enabled $t - the manager did not pick it up" >&2
        failed=$((failed + 1))
      fi
    done
    if [ "$failed" -ne 0 ]; then
      echo >&2
      echo "Unit files are written but the systemd user manager cannot see them." >&2
      echo "It searches \$HOME/.config/systemd/user unless it was started with" >&2
      echo "XDG_CONFIG_HOME=$XDG_CONFIG_HOME is set but no unit directory exists under it." >&2
      echo "The daemon and watchdog still work as transient units:" >&2
      echo "  ./minictrl install-transient" >&2
      echo "For permanent enablement, free a few MB under \$HOME and re-run this." >&2
      exit 1
    fi
    echo "all enabled. start with: minictrl service start"
    ;;

  install-transient)
    # The systemd user manager will not see units in $XDG_CONFIG_HOME (it
    # resolves paths from its own start-time environment, and /home is at user
    # quota so $HOME/.config/systemd/user cannot exist). It DOES search
    # /run/user/$UID/systemd/user, which is writable. Install the rendered unit
    # files there and start them, so the unit file stays the single source of
    # truth instead of its properties being duplicated onto a command line.
    # Not persistent across a manager restart or a reboot; see the note below.
    RUN_UNITS="/run/user/$(id -u)/systemd/user"
    [ -d "$RUN_UNITS" ] || { echo "FATAL: $RUN_UNITS does not exist" >&2; exit 2; }
    render() {
      sed -e "s|@ROOT@|$ROOT_DIR|g" \
          -e "s|@PYTHON@|$PYTHON_BIN|g" \
          -e "s|@ENVBIN@|$ENVBIN|g" \
          -e "s|@ENVFILE@|$ENV_FILE|g" \
          "$ROOT_DIR/$1" > "$RUN_UNITS/$2"
    }
    render tools/ollama.service.in     ollama.service
    render tools/autopoiesis.service.in  "$SERVICE_NAME"
    render tools/watchdog.service.in   quant-watchdog.service
    cp "$ROOT_DIR/tools/watchdog.timer" "$RUN_UNITS/quant-watchdog.timer"
    # A transient unit with the same name shadows the file unit and, once it is
    # gone, the manager keeps reporting "Unit not found" for the file unit too.
    # Clear any transient record before reloading.
    for u in ollama.service "$SERVICE_NAME" quant-watchdog.service; do
      systemctl --user stop "$u" 2>/dev/null
      systemctl --user reset-failed "$u" 2>/dev/null
    done
    systemctl --user daemon-reload
    # `enable` is deliberately NOT used. It creates a symlink under
    # $HOME/.config/systemd/user/default.target.wants/, and /home is at user
    # quota on this host, so it always fails. It is also meaningless for units
    # living in /run, which is tmpfs. Start them, and say plainly that they are
    # not reboot-persistent.
    for u in ollama.service "$SERVICE_NAME" quant-watchdog.timer; do
      if ! systemctl --user list-unit-files 2>/dev/null | grep -q "^$u "; then
        echo "  $u is not visible to the manager" >&2
        continue
      fi
      # Clear any tripped start-limit first. StartLimitBurst=5 in 900s exists
      # to stop a broken daemon spinning forever, but it also trips on repeated
      # *manual* restarts during development and then refuses to start at all,
      # which looks like the service is broken rather than protected.
      systemctl --user reset-failed "$u" 2>/dev/null
      if systemctl --user start "$u" 2>/dev/null; then
        sleep 1
        state="$(systemctl --user is-active "$u" 2>&1)"
        if [ "$state" = "active" ]; then
          echo "  started $u"
        else
          echo "  $u start returned 0 but is $state" >&2
        fi
      else
        echo "  FAILED to start $u" >&2
      fi
    done
    echo
    echo "These live in /run, so they are lost on reboot or a manager restart."
    echo "For permanent enablement, free a few MB under \$HOME so that"
    echo "\$HOME/.config/systemd/user can be created, then: minictrl install-service"
    ;;

  service-status)
    for u in ollama.service "$SERVICE_NAME" quant-watchdog.timer; do
      printf '  %-26s active=%-10s enabled=%-10s restarts=%s\n' "$u" \
        "$(systemctl --user is-active "$u" 2>&1)" \
        "$(systemctl --user is-enabled "$u" 2>&1)" \
        "$(systemctl --user show "$u" -p NRestarts --value 2>/dev/null)"
    done
    ;;

  service)
    sub="${1:-status}"
    systemctl --user "$sub" "$SERVICE_NAME"
    ;;

  logs)
    journalctl --user -u "$SERVICE_NAME" -f "${@:2}"
    ;;

  ""|-h|--help|help) usage ;;

  *)
    echo "unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
