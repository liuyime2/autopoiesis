# Historical integrity diagnostic example, not evidence of scientific preregistration.
# Review and freeze an external file before using it; scheduled runs never auto-register.
hypothesis: the existing threshold grid yields positive mean fold return after costs
family: threshold-grid-integrity-diagnostic
# Cite the signal-ledger test that motivates a new hypothesis (a name or a prefix, e.g. long:13etf:RV21),
# or declare it exploratory. A diagnostic of the pipeline itself is the latter.
ledger_ref: none
instrument: SPY
interval: 5Min
window_start_utc: 2026-04-10T13:30:00Z
window_end_utc: 2026-10-09T19:40:00Z
rule: threshold_grid_v1
primary_metric: oos_return_pct_after_cost_v1
expected_trades: 100
thresholds: 0.0005,0.001,0.002,0.005,0.0075,0.010,0.015,0.020,0.025,0.030
candidate_budget: 11
evaluator: walk_forward_v1
n_folds: 60
min_train_bars: 20
commission_pct: 0.005
slippage_pct: 0.005
