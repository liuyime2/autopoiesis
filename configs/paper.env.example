# autopoiesis configuration
#
# Every variable `src/autopoiesis/config.py` reads, with the default that applies when you do
# not set it. Generated from `AgentConfig.from_env()`, so it cannot drift from the code:
# `check_config-example-names-are-real` fails if this file names a setting nothing reads, and
# `check_config-example-covers-every-variable` fails if the loader reads a setting this file
# omits.
#
# How to use it:
#
#   mkdir -p "${XDG_CONFIG_HOME:-$HOME/.config}/autopoiesis"
#   cp configs/paper.env.example "${XDG_CONFIG_HOME:-$HOME/.config}/autopoiesis/env"
#   chmod 600 "${XDG_CONFIG_HOME:-$HOME/.config}/autopoiesis/env"
#   $EDITOR "${XDG_CONFIG_HOME:-$HOME/.config}/autopoiesis/env"   # fill in the credentials
#   ./minictrl once                       # one cycle, to check it works
#   ./minictrl install-service            # install the systemd --user unit
#
# Where the file goes
#
Every entry point resolves this the same way: `$XDG_CONFIG_HOME/autopoiesis/env`, falling back to `$HOME/.config/autopoiesis/env` when `XDG_CONFIG_HOME` is unset. That is the Makefile's `ENVFILE`, `minictrl`'s `ENV_FILE`, and `tools/verify.py`'s check. An earlier version of this file hardcoded `~/.config/autopoiesis`, and on this host - where `XDG_CONFIG_HOME` points elsewhere and `~/.config/autopoiesis` does not exist - that instruction put the credentials somewhere nothing reads them.
#
# Not environment variables: `CURRICULUM_NUM_CTX` and `CURRICULUM_TIMEOUT_S` appeared in an
# earlier version of this file. They were never read from the environment - they are
# constants in `llm_decision.py` - so setting them did nothing. They are gone rather than
# documented as if they worked.

# The project was renamed to `autopoiesis`. Every setting below is read from the
# `AUTOPOIESIS_` prefix and, as a fallback, from the `MIN_AGENT_` prefix an existing env file
# already uses. The current prefix wins where both are set. `doctor`'s `config prefix` check
# reports how many settings are still on the old name, because the defaults underneath are
# narrower than what this account is authorised to trade and dropping the fallback without
# renaming would quietly reset them.
# ---------------------------------------------------------------------------
# Credentials. The only two values you must fill in.
# ---------------------------------------------------------------------------
# The APCA_* forms are the Alpaca SDK's own names and take precedence if both are set.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=

# ---------------------------------------------------------------------------
# Broker. The paper URL is the default and the only one `cli.py` will start a client
# against without an explicit override; a live URL is rejected before a client is built.
# ---------------------------------------------------------------------------
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# APCA_API_BASE_URL=

# ---------------------------------------------------------------------------
# What to trade. The allowlist is a hard boundary, not a preference: a symbol outside it
# never reaches the decision engine.
# ---------------------------------------------------------------------------
# paper is the only mode wired for trading. `shadow` routes decisions to a sink that
# submits nothing, which is how you exercise the loop without sending orders.
AUTOPOIESIS_MODE=paper
AUTOPOIESIS_SYMBOLS=SPY
AUTOPOIESIS_ALLOWLIST=SPY,NVDA,QQQ,MSFT,AAPL
# AUTOPOIESIS_SHADOW=false
# Short selling: off (default) | shadow (journal SHORT/COVER as intents, long orders stay
# real) | paper (submit them). Guardian allows a SHORT only when the account holds no long in
# the symbol, and bounds it by MAX_POSITION_VALUE and MAX_TOTAL_EXPOSURE.
# AUTOPOIESIS_SHORTS=off

# ---------------------------------------------------------------------------
# Hard risk limits. Read once by `config.py` and enforced by `guardian.py`, which has no
# bypass. Lowering these is safe; raising them is the one thing you should not do without
# auditing the paper behaviour first.
# ---------------------------------------------------------------------------
AUTOPOIESIS_MAX_POSITION_VALUE=5000
AUTOPOIESIS_MAX_DAILY_LOSS=500
AUTOPOIESIS_MAX_TOTAL_EXPOSURE=20000
AUTOPOIESIS_MAX_TRADES_PER_DAY=10
# Whether the agent manages every position in the account (true) or may sell only the shares
# it bought itself (false, the default). The account holder's decision. To manage held
# symbols, also list them in AUTOPOIESIS_SYMBOLS and AUTOPOIESIS_ALLOWLIST.
AUTOPOIESIS_MANAGE_ACCOUNT=false
# Which symbols may be traded: allowlist (default, AUTOPOIESIS_ALLOWLIST only), account (that plus
# every symbol the account holds), or tradable (that plus any active US stock on a major exchange
# priced at least AUTOPOIESIS_MIN_PRICE, never a warrant/unit/right). The account holder's decision;
# every other Guardian rule still applies. Under account/tradable a SELL is bounded by the
# account's position and the exposure cap measures the whole account.
AUTOPOIESIS_UNIVERSE=allowlist
AUTOPOIESIS_MIN_PRICE=5
# Extra symbols looked at each round (tradable only): the broker's most-active liquid names.
AUTOPOIESIS_ATTENTION_SLOTS=0
# Seconds one trading decision may take before the strategy's rule decides instead. The model
# thinks before it answers (30-50s typical, 122s measured once), so 120 was too tight.
AUTOPOIESIS_LLM_TIMEOUT_SECONDS=240
AUTOPOIESIS_MAX_ACCOUNT_VALUE=0
# Assumed round-trip cost, in percent, for counterfactual scoring: what a HOLD would have
# earned net of trading it. A 0 here flatters every hold.
AUTOPOIESIS_ASSUMED_ROUND_TRIP_COST_PCT=0.05
# The return at which the agent is considered to have met its objective.
AUTOPOIESIS_PROFIT_TARGET_RETURN_PCT=0.1

# ---------------------------------------------------------------------------
# Decision engine. Local Ollama by default; there is no hosted-model dependency.
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
# `minictrl install-service` writes these into ollama.service, and it refuses to
# write the unit at all if it cannot resolve them. It used to fall back to the
# literal /usr/local/bin/ollama, which does not exist here: the install succeeded,
# `systemd-analyze verify` passed because it does not stat ExecStart, and the
# service only failed 40 minutes later when it was next started - on a unit that had
# been up a day and a half. Ollama decides trades, so for that window every decision
# silently came from the policy engine instead of the model.
#
# Declare both. A candidate list of plausible directories was tried and dropped:
# the real install on this host is under neither $HOME nor /usr/local, so any list
# covering it would be a list written for one machine.
OLLAMA_BIN=/path/to/ollama
OLLAMA_MODELS=/path/to/ollama/models
AUTOPOIESIS_MODEL=qwen3.8:27b
# Measured 2026-10-03 over all 114 trades the gate can see: it has fired once in 1179
# cycles and was right — it blocked a SELL the counterfactual scores as a FALSE_TRADE,
# 22 points below its own day's base rate. Do not raise it. Every setting above 0.5 blocks
# sets that underperform their own days (at 0.65, 24 right against 13 wrong); the LLM's
# own trades never reach the gate, because its lowest stated confidence is exactly 0.5.
AUTOPOIESIS_MIN_CONFIDENCE=0.5
# How long to look back when scoring a HOLD against the trade actually taken.
AUTOPOIESIS_COUNTERFACTUAL_HORIZON_HOURS=24
# Comma-separated GPU indices Ollama should use.
AUTOPOIESIS_GPU_DEVICES=0

# ---------------------------------------------------------------------------
# Paths. Relative paths resolve against the repository root, so a clone is self-contained.
# These default to runtime/ inside the repository, which is gitignored and therefore
# per-clone: two clones do not share a journal. Point them somewhere durable and off the
# working tree if you want state to outlive the checkout. An earlier version of this file
# claimed $HOME was at quota and could not hold state; that was false - it has terabytes
# free - and the real reason to move state out of a clone is that a clone is disposable.
# ---------------------------------------------------------------------------
AUTOPOIESIS_JOURNAL=runtime/autopoiesis/journal.jsonl
AUTOPOIESIS_HEARTBEAT=runtime/autopoiesis/heartbeat.json
AUTOPOIESIS_PIDFILE=runtime/autopoiesis/daemon.pid
AUTOPOIESIS_STRATEGY_DIR=runtime/autopoiesis/strategies
AUTOPOIESIS_KNOWLEDGE_DIR=runtime/autopoiesis/knowledge
# `minictrl` reads this, not `config.py` - it is the bin directory the systemd units are
# rendered with, so an operator whose conda envs live outside the default roots needs it.
# Unset is fine when conda can find the env itself (an activated environment, a
# CONDA_ENVS_PATH, or a well-known install prefix). It was the one variable in the deployed
# env file that this example never mentioned, so the only place its name appeared was the
# error message minictrl prints when it cannot guess - which is a bad place to learn a
# setting's name from.
AUTOPOIESIS_ENVBIN=

# ---------------------------------------------------------------------------
# Cycle and maintenance timing.
# ---------------------------------------------------------------------------
AUTOPOIESIS_DAEMON_INTERVAL_SECONDS=300
AUTOPOIESIS_MAX_DAILY_CYCLES=288
# A heartbeat older than this marks the agent dead rather than slow.
AUTOPOIESIS_STALE_AFTER_SECONDS=900
AUTOPOIESIS_MAINTENANCE_INTERVAL_SECONDS=900
AUTOPOIESIS_EVIDENCE_INTERVAL_SECONDS=3600
AUTOPOIESIS_REFLECTION_INTERVAL_SECONDS=1800
AUTOPOIESIS_CURRICULUM_INTERVAL_SECONDS=3600

# ---------------------------------------------------------------------------
# Learning. All of this is off or inert by default: the agent proposes, and admission and
# evaluation decide whether anything is kept.
# ---------------------------------------------------------------------------
AUTOPOIESIS_REFLECTION_WINDOW=50
AUTOPOIESIS_REFLECT_EVERY=10
AUTOPOIESIS_CURRICULUM_ENABLED=false
AUTOPOIESIS_CURRICULUM_EVERY=50