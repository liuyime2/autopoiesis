# Copy to $XDG_CONFIG_HOME/min-agent/env and fill in. Never commit the filled-in copy.
#
# The system reads configuration from the environment only. There is deliberately no
# config file loader: one source of truth for configuration means one place to look, and
# an environment variable is the same thing every other tool on the machine already reads.
#
# `make check-env` prints what the system actually resolved, which is the quickest way to
# confirm a value landed.

# --- required ---------------------------------------------------------------
# Paper credentials. A base URL containing "paper" is required; the CLI refuses anything
# else before it constructs a client, in all four code paths that build one.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# --- hard risk limits -------------------------------------------------------
# Read once by config.py, enforced by Guardian, which has no bypass. Lowering a limit
# is a legitimate tightening. Raising one is an operator risk decision, and nothing in
# the codebase raises them.
MIN_AGENT_MAX_POSITION_VALUE=5000
MIN_AGENT_MAX_DAILY_LOSS=500
MIN_AGENT_MAX_TRADES_PER_DAY=10
MIN_AGENT_MIN_CONFIDENCE=0.5
# Defaults to 4x max_position_value.
# MIN_AGENT_MAX_TOTAL_EXPOSURE=20000

# --- cadence and liveness ---------------------------------------------------
# Seconds between cycles while the market is open.
MIN_AGENT_DAEMON_INTERVAL_SECONDS=300
# A heartbeat older than this is reported as a dead daemon. The closed-market sleep is
# held to 75% of it, because a sleep equal to it puts the next beat exactly on the
# threshold and every liveness check then reports a live daemon dead.
MIN_AGENT_STALE_AFTER_SECONDS=900
# How long the daemon may sleep before writing another heartbeat.
MIN_AGENT_MAINTENANCE_INTERVAL_SECONDS=900

# --- model ------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
MIN_AGENT_MODEL=qwen3.8:27b
# num_ctx is per call site and must not be shared: the decision prompt fits in 4096,
# the curriculum prompt does not, and reusing 4096 truncated replies to an empty body.
# CURRICULUM_NUM_CTX=8192
# CURRICULUM_TIMEOUT_S=600

# --- data paths -------------------------------------------------------------
# Default under the repository. Journal is the source of truth and is never rotated away
# without its backups; everything else here is derived from it and regenerable.
# MIN_AGENT_RUNTIME_DIR=runtime/min_agent
