        "code": "import pandas as pd\n\n# Fetch 1D historical data for AAPL\ndata = env.get_historical_data('AAPL', '1D', 50)\n\n# Calculate 50-day SMA\nif len(data) >= 50:\n    sma = data['close'].rolling(50).mean()\n    print(f\"50-day SMA: {sma.iloc[-1]}\")\nelse:\n    print(\"Not enough data points to calculate 50-day SMA\")",
