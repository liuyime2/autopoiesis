    "execute_50dma_strategy": {
        "code": "import pandas as pd\nimport numpy as np\n\n# Define the trading symbol and parameters\nSYMBOL = 'AAPL'\nTIMEFRAME = '1d'\nLIMIT = 50\nQUANTITY = 10  # Base quantity to trade\n\nclass QuantVoyagerAgent:\n    def __init__(self):\n        self.cash = 99400.0\n        self.position = 0\n        self.portfolio_history = []\n        \n    def calculate_50dma(self):\n        \"\"\"Calculate 50-day moving average\"\"\"\n        data = env.get_historical_data(SYMBOL, TIMEFRAME, LIMIT)\n        if len(data) < 50:\n            raise ValueError(\"Not enough historical data\")\n        return data['close'].rolling(window=50).mean().iloc[-1]\n    \n    def partisan_doctrine_rule(self, current_price, fifty_dma):\n        \"\"\"Partisan Doctrine Rule implementation\"\"\"\n        # Rule 1: Buy when price crosses above 50DMA\n        if current_price > fifty_dma and self.position == 0:\n            return 'BUY'\n        \n        # Rule 2: Sell when price crosses below 50DMA\n        elif current_price < fifty_dma and self.position > 0:\n            return 'SELL'\n        \n        # Rule 3: Stay neutral otherwise\n        else:\n            return 'HOLD'\n    \n    def execute_trades(self):\n        \"\"\"Main trading execution logic\"\"\"\n        try:\n            # Get current market data\n            current_price = env.get_current_price(SYMBOL)\n            fifty_dma = self.calculate_50dma()\n            \n            # Apply partisan doctrine rule\n            action = self.partisan_doctrine_rule(current_price, fifty_dma)\n            \n            # Execute based on rule\n            if action == 'BUY':\n                self.buy_stock(current_price)\n            elif action == 'SELL':\n                self.sell_stock(current_price)\n                \n            # Update portfolio history\n            self.update_portfolio_history(current_price)\n            \n        except Exception as e:\n            print(f\"Error in trading execution: {str(e)}\")\n            return None\n        \n        return self.position\n    \n    def buy_stock(self, current_price):\n        \"\"\"Execute buy order\"\"\"\n        available_cash = self.cash\n        max_shares = max(int(available_cash // current_price), 1)\n        shares_to_buy = min(max_shares, QUANTITY)\n        \n        if shares_to_buy > 0:\n            self.position += shares_to_buy\n            self.cash -= shares_to_buy * current_price\n            env.submit_order(SYMBOL, shares_to_buy, 'buy', 'market', current_price)\n            print(f\"Bought {shares_to_buy} shares at ${current_price:.2f}\")\n    \n    def sell_stock(self, current_price):\n        \"\"\"Execute sell order\"\"\"\n        if self.position > 0:\n            shares_to_sell = min(self.position, QUANTITY)\n            self.position -= shares_to_sell\n            self.cash += shares_to_sell * current_price\n            env.submit_order(SYMBOL, shares_to_sell, 'sell', 'market', current_price)\n            print(f\"Sold {shares_to_sell} shares at ${current_price:.2f}\")\n    \n    def update_portfolio_history(self, current_price):\n        \"\"\"Update portfolio history\"\"\"\n        portfolio_value = self.cash + (self.position * current_price)\n        portfolio_data = {\n            'cash': self.cash,\n            'position': self.position,\n            'portfolio_value': portfolio_value\n        }\n        self.portfolio_history.append(portfolio_data)\n        print(f\"Portfolio value: ${portfolio_value:.2f}\")\n\n# Initialize and run the agent\nagent = QuantVoyagerAgent()\nwhile agent.execute_trades() is not None:\n    continue",
        "description": "Write a Python script that uses the 'calculate_50dma' skill to determine market trend and the 'partisan_doctrine_rule' to execute trades avoiding potential conflicts, maximizing profit from the current portfolio of $99400.0."
    },
    "calculate_profit_stop": {
        "code": "import numpy as np\n\n# Get current price\ncurrent_price = env.get_current_price('AAPL')\n\n# Define parameters\ntarget_profit_percent = 0.05  # 5% target profit\nstop_loss_percent = 0.02     # 2% stop loss\nquantity = 100               # Quantity of shares to trade\n\n# Calculate target prices\ntarget_price = current_price * (1 + target_profit_percent)\nstop_loss_price = current_price * (1 - stop_loss_percent)\n\n# Submit stop-loss order\nenv.submit_order(\n    symbol='AAPL',\n    quantity=quantity,\n    side='sell',\n    order_type='stop',\n    limit_price=stop_loss_price\n)\n\n# Print calculated prices (for verification)\nprint(f\"Current Price: {current_price}\")\nprint(f\"Target Profit Price: {target_price}\")\nprint(f\"Stop Loss Price: {stop_loss_price}\")",
        "description": "Write a Python script that, given a current price and a target profit percentage, calculates the target price to take profits and sets a stop-loss order at a specified percentage loss from the current price."
