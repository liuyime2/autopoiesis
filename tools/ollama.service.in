[Unit]
Description=Ollama LLM server (dependency of the min_agent paper-trading daemon)
Documentation=https://github.com/ollama/ollama
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1800
StartLimitBurst=5
# The agent must not start before the model endpoint it calls, or the first
# cycles would all fall back and journal themselves as fallback_policy_engine.
Before=min-agent.service

[Service]
Type=exec
ExecStart=/localscratch/liuyime2/ollama_local/bin/ollama serve

# The models live outside the default ~/.ollama. The last recorded run
# (ollama.log) served on :11435 with CUDA_VISIBLE_DEVICES=3 while the agent was
# configured for :11434 and GPU 0; these three settings are the reconciled
# values the agent is actually verified against.
Environment=OLLAMA_MODELS=/localscratch/liuyime2/ollama_local/models
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=CUDA_VISIBLE_DEVICES=0
# From 0.13 the build auto-detects Vulkan as well as CUDA, and will shard one
# model across all ten GPUs over PCIe instead of using CUDA on a single device:
# deepseek-r1:8b went from 2.3s to 254s per call, and the journal shows a
# five-minute curriculum call. Off, so the pin above is what actually runs.
# OLLAMA_LLM_LIBRARY=cuda is NOT set: naming a library made this build fall
# back to CPU entirely.
Environment=OLLAMA_VULKAN=0

# One model, one slot, resident forever. The agent uses qwen3.8:27b and nothing
# else (src/min_agent/config.py:76 pins it), so there is no second model to make
# room for. MAX_LOADED_MODELS=2 was what let a second model evict the first: two
# 27B-class models do not fit in 45 GiB alongside KV cache, so the agent's model
# was being unloaded and cold-reloaded mid-session.
Environment=OLLAMA_MAX_LOADED_MODELS=1
# NUM_PARALLEL=1 is deliberate. The agent is single-threaded per cycle on one
# device; parallel slots only split the same VRAM between contexts.
Environment=OLLAMA_NUM_PARALLEL=1
# Keep the model resident. Unloaded, the next call must first read ~16.3 GiB of
# weights off /localscratch, measured at ~3 minutes of load against a 120s client
# timeout - so an off-hours call reliably timed out, which is exactly the shape of
# the recorded CURRICULUM_FAILED timeouts. Resident, the same call takes 10-30s.
# -1 means "do not unload", which is what one dedicated model on a dedicated card
# wants.
Environment=OLLAMA_KEEP_ALIVE=-1

Restart=always
RestartSec=10
# Loading a model after a crash can take minutes; do not declare a crash loop
# while it is still warming up.
TimeoutStartSec=300

[Install]
WantedBy=default.target
