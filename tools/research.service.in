[Unit]
Description=autopoiesis unattended strategy research: fetch real bars, then search
After=network-online.target autopoiesis.service
Wants=network-online.target

[Service]
# Private by default. The runtime directory holds account snapshots, model rationales and
# the journal; on a shared host a 0022 umask makes the journal world-readable, which it was
# until 2026-10-20 (measured: runtime 0755, journal.jsonl 0644). A service that creates the
# files is the only place that can set this for files created *later* - chmod fixes today.
UMask=0077
Type=oneshot
WorkingDirectory=@ROOT@
Environment=PYTHONPATH=@ROOT@/src
Environment=PATH=@ENVBIN@:/usr/local/bin:/usr/bin:/bin
# Paper credentials, same as the daemon: the bars are historical, but the endpoint is the paper
# one because this project does not hold a live key and does not trade history.
Environment=AUTOPOIESIS_MODE=paper
Environment=ALPACA_BASE_URL=https://paper-api.alpaca.markets
Environment=APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Rendered from the same variable as autopoiesis.service, and no leading `-` for the same reason as
# the watchdog: a missing credentials file must stop this unit with the actual cause named, rather
# than starting it and producing a research run with no bars.
EnvironmentFile=@ENVFILE@

# The operator supplies AUTOPOIESIS_RESEARCH_SPEC in the external EnvironmentFile.
# It must already be registered. Make verifies the supported contract before installing
# or fetching, derives symbol/window/interval from it, then runs the shared tape gate.
# Fetch failures stop the unit; stale-cache fallback would hide an incomplete pipeline.
ExecStart=/usr/bin/make -C @ROOT@ PY=@PYTHON@ research-run SPEC=${AUTOPOIESIS_RESEARCH_SPEC}

StandardOutput=append:@ROOT@/runtime/autopoiesis/research.log
StandardError=append:@ROOT@/runtime/autopoiesis/research.log
