[Unit]
Description=Run the autopoiesis health watchdog every 10 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=10min
# Spread across a jittered window so several agents on one host do not all fire
# on the same minute.
RandomizedDelaySec=60
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
